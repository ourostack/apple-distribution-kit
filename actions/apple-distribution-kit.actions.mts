// The agent-facing doors of apple-distribution-kit, declared once. Generate the projections with
//   node tools/ouro-actions/ouro-actions.mts generate actions/apple-distribution-kit.actions.mts actions/generated
// and never edit actions/generated by hand.
import { defineAction, defineActions, field } from "../tools/ouro-actions/ouro-actions.mts";

export const manifestValidate = defineAction({
  id: "manifest_validate",
  consent: "read",
  label: "Validate manifest",
  description: "Check that the distribution manifest is valid.",
  agent: "Validate the distribution manifest and say whether it is valid. Read-only.",
  input: {
    manifest: field.string({ label: "Manifest", description: "Path to the manifest. Defaults to distribution/apple-distribution.json.", optional: true }),
  },
  output: {
    ok: field.boolean({ label: "Valid", description: "True when the manifest is valid." }),
    manifestPath: field.string({ label: "Manifest path", description: "The manifest that was checked." }),
  },
  cli: "manifest validate",
});

export const ascSmoke = defineAction({
  id: "asc_smoke",
  consent: "read",
  label: "Check App Store Connect access",
  description: "Check that the App Store Connect API credentials work.",
  agent: "Verify App Store Connect API credentials without printing secrets. Read-only.",
  input: {
    config: field.string({ label: "Config", description: "Path to the config file with the API key settings.", optional: true }),
  },
  output: {
    ok: field.boolean({ label: "Working", description: "True when the credentials authenticate." }),
  },
  cli: "asc smoke",
});

export const reviewStatus = defineAction({
  id: "review_status",
  consent: "read",
  label: "App Review status",
  description: "See the App Review state of each version of the app.",
  agent: "Read the App Review state of every App Store version and review submission for one bundle id. Read-only.",
  input: {
    bundleId: field.string({ label: "Bundle id", description: "The app's bundle identifier.", arg: true }),
    platform: field.string({ label: "Platform", description: "IOS or MAC_OS. Defaults to both.", optional: true }),
    config: field.string({ label: "Config", description: "Path to the config file with the API key settings.", optional: true }),
  },
  output: {
    versions: field.string({ label: "Versions", description: "JSON: one entry per App Store version and review submission, with its state." }),
  },
  cli: "review status",
});

export const reviewLoginServices = defineAction({
  id: "review_login_services",
  consent: "read",
  label: "Check third-party login",
  description: "Check that a third-party login offers Sign in with Apple before review.",
  agent: "Run the Guideline 4.8 pre-submission check on a project folder. Exits 1 on any finding. Read-only.",
  input: {
    root: field.string({ label: "Project folder", description: "The project folder to check. Defaults to the current folder.", optional: true }),
  },
  output: {
    findings: field.string({ label: "Findings", description: "JSON: one entry per finding." }),
  },
  cli: "review login-services",
});

export default defineActions("apple-distribution-kit", [manifestValidate, ascSmoke, reviewStatus, reviewLoginServices], { tool: "apple-distribution-kit" });
